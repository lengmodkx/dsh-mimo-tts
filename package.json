{
  "name": "dsh-mimo-tts",
  "version": "0.1.0",
  "description": "MiMo voice for DeepSeek Harness: read answers aloud, talk to the composer, switch voices, clone your own. / 小米 MiMo 语音插件：自动朗读回复、点一下说话、音色切换与克隆。",
  "type": "module",
  "license": "MIT",
  "author": "Lemon <lengmodkx@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lengmodkx/dsh-mimo-tts.git"
  },
  "homepage": "https://github.com/lengmodkx/dsh-mimo-tts#readme",
  "bugs": "https://github.com/lengmodkx/dsh-mimo-tts/issues",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "tts",
    "asr",
    "voice",
    "mimo",
    "xiaomi",
    "voice-clone"
  ]
}
